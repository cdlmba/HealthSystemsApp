{
  "entities": {
    "HealthLog": {
      "title": "Health Log",
      "description": "Daily health and habit tracking data",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date", "description": "Date of the log" },
        "userId": { "type": "string", "description": "User ID of the owner" },
        "weight": { "type": "number", "description": "Morning weight (optional)" },
        "sleepQuality": { "type": "integer", "description": "Sleep Quality (1-10)" },
        "wakeups": { "type": "integer", "description": "Number of wake-ups" },
        "energyCrashes": { "type": "integer", "description": "Energy Crashes (0=none, 1=mild, 2=mod, 3=severe)" },
        "chairStandEase": { "type": "integer", "description": "Chair Stand Ease (1-10)" },
        "gymCompleted": { "type": "boolean", "description": "Gym Session Completed" },
        "fastedGymEnergy": { "type": "integer", "description": "Fasted Gym Energy (1-10)" },
        "eatingWindowAdherence": { "type": "boolean", "description": "Eating Window Adherence" },
        "eggMeal": { "type": "boolean", "description": "9:30 AM Eggs Meal (80% full)" },
        "lunchProtein": { "type": "boolean", "description": "Lunch Protein-First + Walk" },
        "dinnerTime": { "type": "boolean", "description": "Dinner by 7:30 PM" },
        "postMealWalks": { "type": "integer", "description": "Post-Meal Walks Completed" },
        "dailyProtein": { "type": "number", "description": "Daily Protein Estimate (g)" },
        "hydration": { "type": "integer", "description": "Hydration (glasses / 8+)" },
        "mobility": { "type": "boolean", "description": "Mobility / Sit-to-Stands" },
        "notes": { "type": "string", "description": "Daily Notes" },
        "caloriesLogged": { "type": "number", "description": "Calories logged" },
        "proteinLogged": { "type": "number", "description": "Protein logged" },
        "fatLogged": { "type": "number", "description": "Fat logged" },
        "carbsLogged": { "type": "number", "description": "Carbs logged" },
        "stressLevel": { "type": "number", "description": "Stress Level (1-5)" },
        "waterOz": { "type": "number", "description": "Water (oz)" },
        "morningWeight": { "type": "number", "description": "Morning Weight" },
        "workoutSessionId": { "type": "string", "description": "Workout Session ID" },
        "zone2Minutes": { "type": "number", "description": "Zone 2 Minutes" }
      },
      "required": ["date", "userId"]
    },
    "UserProfile": {
        "title": "User Profile",
        "description": "Basic user data",
        "type": "object",
        "properties": {
            "displayName": { "type": "string" },
            "email": { "type": "string" },
            "photoURL": { "type": "string" }
        },
        "required": ["email"]
    },
    "WorkoutSession": {
        "title": "Workout Session",
        "type": "object",
        "properties": {
            "userId": { "type": "string" },
            "date": { "type": "string" },
            "templateName": { "type": "string" },
            "completedAt": { "type": "string" }
        },
        "required": ["userId", "date", "templateName"]
    },
    "Exercise": {
        "title": "Exercise",
        "type": "object",
        "properties": {
            "userId": { "type": "string" },
            "name": { "type": "string" }
        },
        "required": ["userId", "name"]
    },
    "WeeklySummary": {
        "title": "Weekly Summary",
        "type": "object",
        "properties": {
            "userId": { "type": "string" },
            "weekStart": { "type": "string" },
            "avgWeight": { "type": "number" }
        },
        "required": ["userId", "weekStart"]
    }
  },
  "firestore": {
    "/healthLogs/{logId}": {
      "schema": "HealthLog",
      "description": "Collection of daily health logs"
    },
    "/users/{userId}": {
        "schema": "UserProfile",
        "description": "User profiles"
    },
    "/workoutSessions/{sessionId}": {
        "schema": "WorkoutSession",
        "description": "User workout sessions"
    },
    "/exercises/{exerciseId}": {
        "schema": "Exercise",
        "description": "User defined exercises"
    },
    "/weeklySummaries/{summaryId}": {
        "schema": "WeeklySummary",
        "description": "Weekly summaries and recommendations"
    }
  }
}
