rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for HealthLog
    function isValidHealthLog(data) {
      return data.userId == request.auth.uid &&
             data.date is string &&
             data.date.size() <= 64 &&
             (data.notes == null || (data.notes is string && data.notes.size() <= 5000));
    }

    // Rules for Health Logs
    match /healthLogs/{logId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidHealthLog(incoming()) && isValidId(logId);
      allow update: if isSignedIn() && isOwner(existing().userId) && isValidHealthLog(incoming());
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }

    // Rules for User Profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }
  }
}
